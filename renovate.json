{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "schedule:monthly",
    ":semanticCommitTypeAll(build)",
    ":semanticCommitScope(deps)",
    ":automergeMinor",
    ":dependencyDashboard"
  ],
  "minimumReleaseAge": "7 days",
  "labels": [
    "dependencies",
    "area:devops"
  ],
  "packageRules": [
    {
      "groupName": "Next.js",
      "matchPackageNames": ["next", "eslint-config-next"]
    }
  ]
}
