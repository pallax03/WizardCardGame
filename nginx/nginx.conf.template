server {
    listen 80;

    # Usa il DNS interno di Docker per risolvere i nomi dei container "al volo" (a runtime)
    # Questo evita che NGINX crashi all'avvio se il backend è temporaneamente spento!
    resolver 127.0.0.11 valid=10s;

    # Route per il backend (motore di gioco)
    location /api {
        set $backend "http://wizard-engine:${HTTP_PORT}";
        proxy_pass $backend;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Route per WebSockets (se usati dal backend)
    location /socket.io {
        set $backend "http://wizard-engine:${WS_PORT}";
        proxy_pass $backend;
        
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Rotta di default per l'applicazione Next.js (frontend)
    location / {
        set $frontend "http://application:${APPLICATION_PORT}";
        proxy_pass $frontend;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Supporto per Next.js hot-reloading (WebSocket)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
