{
  "name": "wizard-card-game",
  "version": "0.0.0",
  "private": true,
  "description": "Wizard Card Game",
  "workspaces": [
    "application",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "husky || true",
    "check": "npm run check:engine && npm run check:client",
    "check:engine": "cd wizardEngine && sbt --batch check",
    "check:client": "npm -w application run check",
    "format:engine": "cd wizardEngine && sbt --batch format",
    "format:client": "npm -w application run format",
    "build:engine": "cd wizardEngine && sbt --batch stage",
    "build:client": "npm -w application run build"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.3"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.0"
  }
}
